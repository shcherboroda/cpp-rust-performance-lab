# Local Bitfinex Raw Books (L3) capture configuration.
# Copy this file to .env. This public feed requires no API key or secret.

# Initial capture target. R0 delivers individual order IDs rather than
# price-aggregated levels. A maximum length of 250 is currently supported.
BITFINEX_SYMBOL=tBTCUSD
BITFINEX_BOOK_PRECISION=R0
BITFINEX_BOOK_FREQUENCY=F0
BITFINEX_BOOK_LENGTH=250
BITFINEX_WS_ENDPOINT=wss://api-pub.bitfinex.com/ws/2

# Bybit V5 public L2 capture. No API key is needed. Copy this file to .env;
# command-line options override these fields. Captures (*.llfr) are ignored and
# contain exact inbound frames plus the outbound subscription request.
BYBIT_SYMBOL=BTCUSDT
BYBIT_ORDERBOOK_DEPTH=50
BYBIT_WS_HOST=stream.bybit.com
BYBIT_WS_TARGET=/v5/public/spot
BYBIT_MAX_FRAMES=100
# BYBIT_CAPTURE_PATH=data/captures/bybit-btcusdt-50.llfr
