# Local Coinbase Exchange capture configuration.
# Copy this file to .env and replace only the empty values below.
# Never commit .env or share its values.

# Coinbase Exchange API credentials for the authenticated `full` WebSocket feed.
COINBASE_API_KEY=
COINBASE_API_PASSPHRASE=
COINBASE_API_SECRET=

# Initial capture target. Keep one high-volume product per connection.
COINBASE_PRODUCT_ID=BTC-USD
COINBASE_WS_ENDPOINT=wss://ws-feed.exchange.coinbase.com
COINBASE_REST_ENDPOINT=https://api.exchange.coinbase.com
